# Yönetim paneli (/yonetim)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=guclu-bir-parola
# En az 32 karakter. Örnek üretim: openssl rand -base64 32
SESSION_SECRET=buraya-en-az-32-karakterlik-rastgele-bir-deger
# İsteğe bağlı. PIN korumalı belge paylaşımları için ayrı HMAC anahtarı.
# Boş bırakılırsa SESSION_SECRET kullanılır. En az 32 karakter.
DOCUMENT_SHARE_PIN_SECRET=

# İsteğe bağlı. Varsayılan: proje kökündeki uploads klasörü
CONTENT_STORAGE_PATH=/var/lib/rdmhukuk/uploads

# İletişim formu
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=
# İsteğe bağlı. Boş bırakılırsa SESSION_SECRET kullanılır. En az 32 karakter.
CONTACT_RATE_LIMIT_SECRET=
